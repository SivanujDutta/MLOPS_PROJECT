// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  passwordHash              String
  role                      Role      @default(USER)
  isEmailVerified           Boolean   @default(false)
  verifyEmailToken          String?
  verifyEmailTokenExpiry    DateTime?
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  datasets Dataset[]
  apiKeys  ApiKey[]
}

model Dataset {
  id             String   @id @default(uuid())
  userId         String
  name           String
  s3Url          String
  rowCount       Int?
  columnSchema   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  experiments  Experiment[]
}

enum TaskType {
  REGRESSION
  CLASSIFICATION
}

enum ExperimentStatus {
  QUEUED
  TUNING
  TRAINING
  COMPLETED
  FAILED
}

model Experiment {
  id           String           @id @default(uuid())
  datasetId    String
  targetColumn String
  taskType     TaskType
  status       ExperimentStatus @default(QUEUED)
  selectedFeatures Json?
  errorMessage String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id])
  models  Model[]
}

model Model {
  id                String   @id @default(uuid())
  experimentId      String
  algorithmName     String
  hyperparameters   Json?
  metrics           Json?
  featureImportance Json?
  s3ModelPath       String?
  isDeployed        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  experiment  Experiment   @relation(fields: [experimentId], references: [id])
  deployments Deployment[]
}

enum DeploymentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Deployment {
  id            String           @id @default(uuid())
  modelId       String
  endpointSlug  String           @unique
  status        DeploymentStatus @default(ACTIVE)
  totalRequests Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  model          Model           @relation(fields: [modelId], references: [id])
  predictionLogs PredictionLog[]
}

model PredictionLog {
  id               String   @id @default(uuid())
  deploymentId     String
  inputData        Json
  predictionOutput Json
  latencyMs        Int?
  createdAt        DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id])
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  name      String
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
